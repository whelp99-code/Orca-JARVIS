[Unit]
Description=JM JARVIS signed native evening report (candidate; operator activation required)

[Service]
Type=oneshot
WorkingDirectory=/home/jm/.local/state/orca-jarvis/authority/current
Environment=NODE_ENV=production
ExecStart=/home/jm/.nvm/versions/node/v24.19.0/bin/node /home/jm/.local/state/orca-jarvis/authority/current/dist/src/cli.js daily evening --once --db /home/jm/.local/state/orca-jarvis/jarvis.sqlite --input /home/jm/.config/orca-jarvis/evening.json --key-file /home/jm/.config/orca-jarvis/evening.pem
TimeoutStartSec=120
ReadWritePaths=/home/jm/.local/state/orca-jarvis
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
