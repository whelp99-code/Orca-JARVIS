[Unit]
Description=JM Second Brain apply-requests once

[Service]
Type=oneshot
WorkingDirectory=/home/jm/.local/state/second-brain/app/current
ExecStart=/home/jm/.local/bin/sb apply-requests --once
ReadWritePaths=/home/jm/.local/state/second-brain
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

