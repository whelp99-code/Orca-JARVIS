[Unit]
Description=JM Second Brain sealed-generation backup
After=jm-second-brain-refresh.service

[Service]
Type=oneshot
WorkingDirectory=/home/jm/.local/state/second-brain/app/current
ExecStart=/home/jm/.local/state/second-brain/app/current/bin/sb backup --once --state /home/jm/.local/state/second-brain
ReadWritePaths=/home/jm/.local/state/second-brain
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

