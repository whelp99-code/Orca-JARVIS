[Unit]
Description=JM Second Brain lifecycle maintenance
After=jm-second-brain-refresh.service

[Service]
Type=oneshot
WorkingDirectory=/home/jm/.local/state/second-brain/app/current
Environment=SB_CONFIG=/home/jm/.config/second-brain/config.toml
ExecStart=/home/jm/.local/state/second-brain/app/current/bin/sb maintain --once
ReadWritePaths=/home/jm/.local/state/second-brain /home/jm/.local/share/second-brain
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

