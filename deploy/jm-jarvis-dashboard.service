[Unit]
Description=JM Control Center dashboard (loopback 4173)
After=jm-jarvis.service orca-gui.service
Wants=jm-jarvis.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/jm/.local/state/orca-jarvis/control-center/current
Environment=PATH=/home/jm/.nvm/versions/node/v24.19.0/bin:/home/jm/.local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
UMask=0077
ExecStart=/home/jm/.nvm/versions/node/v24.19.0/bin/node /home/jm/.local/state/orca-jarvis/control-center/current/dist/src/dashboard/main.js --host 127.0.0.1 --port 4173 --db /home/jm/.local/state/orca-jarvis/jarvis.sqlite --static-root /home/jm/.local/state/orca-jarvis/control-center/current/dist/dashboard
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/jm/.local/state/orca-jarvis
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
