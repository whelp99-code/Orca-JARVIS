[Unit]
Description=Refresh Second Brain before the JARVIS morning loop
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/jm
Environment=PATH=/home/jm/.local/bin:/usr/bin:/bin
Environment=SB_CONFIG=/home/jm/.config/second-brain/config.toml
ExecStart=/home/jm/.local/bin/sb run
TimeoutStartSec=900s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/jm/.local/share/second-brain /home/jm/.local/state/second-brain
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
StandardOutput=journal
StandardError=journal
