{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "JARVIS_PHONE_PUBLIC_ORIGIN",
    "JARVIS_PHONE_OWNER_LOGIN",
    "JARVIS_PHONE_SESSION_KEY_FILE"
  ],
  "properties": {
    "JARVIS_PHONE_PUBLIC_ORIGIN": { "type": "string", "pattern": "^https://[^/:]+$" },
    "JARVIS_PHONE_OWNER_LOGIN": { "type": "string", "minLength": 1, "maxLength": 254 },
    "JARVIS_PHONE_SESSION_KEY_FILE": { "type": "string", "minLength": 1 }
  }
}
