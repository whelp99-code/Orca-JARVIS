{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "e2e/**/*.ts", "e2e/**/*.mts", "e2e/**/*.cts", "e2e/**/*.tsx",
    "playwright.config.ts",
    "playwright.remote.config.ts",
    "playwright.task32.config.ts",
    "playwright.finance-readable.config.ts",
    "tests/fixtures/**/*.ts", "tests/fixtures/**/*.mts", "tests/fixtures/**/*.cts", "tests/fixtures/**/*.tsx"
  ]
}
