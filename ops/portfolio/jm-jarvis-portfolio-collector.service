[Unit]
Description=Collect JM-SERVER portfolio status into the spool

[Service]
Type=oneshot
ExecStart=/bin/bash /home/jm/.local/state/orca-jarvis/control-center/current/ops/portfolio/jm-portfolio-collector.sh
TimeoutStartSec=50s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/jm/.local/share/jarvis/portfolio-spool
