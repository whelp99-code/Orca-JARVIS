[Unit]
Description=Ingest spooled JM-SERVER portfolio envelopes into the authority

[Service]
Type=oneshot
ExecStart=/bin/bash /home/jm/.local/state/orca-jarvis/authority/current/ops/portfolio/jm-portfolio-ingest.sh
TimeoutStartSec=50s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/jm/.local/state/orca-jarvis /home/jm/.local/share/jarvis/portfolio-spool
