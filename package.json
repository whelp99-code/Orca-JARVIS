{
  "name": "orca-jarvis-shadow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "bin": {
    "jarvis": "dist/src/cli.js"
  },
  "scripts": {
    "build": "npm run build:backend && npm run build:dashboard",
    "lint": "eslint src tests dashboard e2e playwright.config.ts playwright.remote.config.ts --max-warnings=0",
    "pretest": "npm run build",
    "test": "node scripts/run-tests.mjs backend && node scripts/run-tests.mjs dashboard",
    "acceptance:pre-gjc": "node scripts/run-tests.mjs acceptance",
    "personal-os:eval": "npm run build:backend --silent && node scripts/personal-os-eval.mjs",
    "verify": "npm run runtime:check && npm run lint && npm run typecheck && npm test && npm run acceptance:pre-gjc -- --fixture test/fixtures/pre-gjc-e2e.json --clock 2026-08-09T00:00:00.000Z && node scripts/run-tests.mjs smoke",
    "runtime:check": "node scripts/assert-runtime.mjs",
    "prebuild": "npm run runtime:check",
    "build:backend": "node scripts/build-backend.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.dashboard.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "build:dashboard": "vite build --config dashboard/vite.config.ts",
    "build:fixtures": "npm run build:backend",
    "test:e2e": "npm run build && node scripts/run-tests.mjs e2e",
    "test:e2e:production-smoke": "JARVIS_E2E_NO_FIXTURE=1 playwright test e2e/production-smoke.spec.ts",
    "ops:cleanup-test-artifacts": "node ops/cleanup-test-artifacts.mjs --production --apply",
    "product:install-electron": "install-electron",
    "preproduct:package-electron": "npm run product:install-electron",
    "product:package-electron": "node scripts/package-electron.mjs",
    "product:open-electron": "node scripts/open-electron.mjs",
    "test:backend": "node scripts/run-tests.mjs backend",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:dashboard": "node scripts/run-tests.mjs dashboard",
    "pretest:gui": "npm run product:install-electron && npm run build:backend",
    "test:gui": "node scripts/run-tests.mjs gui"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@simplewebauthn/server": "^13.3.3",
    "better-sqlite3": "^12.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.33.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "44.0.0",
    "eslint": "^9.33.0",
    "fast-check": "^4.9.0",
    "jsdom": "30.0.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "undici": "8.10.0",
    "vite": "7.3.6",
    "vitest": "^3.2.4"
  },
  "packageManager": "npm@11.17.0",
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
