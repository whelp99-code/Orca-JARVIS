{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jarvis://third-party/argo/permission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_sha256",
    "issuer",
    "signer",
    "authority_basis",
    "delegation_chain",
    "grantee",
    "covered",
    "allowed_actions",
    "attribution",
    "expires_at",
    "verifier",
    "verified_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "issuer": { "type": "string", "minLength": 1 },
    "signer": { "type": "string", "minLength": 1 },
    "authority_basis": { "type": "string", "minLength": 1 },
    "delegation_chain": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "grantee": { "type": "string", "minLength": 1 },
    "covered": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "path_patterns"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "path_patterns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["copy", "modify", "derive", "internal_use", "redistribute", "host_for_third_parties"]
      }
    },
    "attribution": { "type": "string", "minLength": 1 },
    "expires_at": { "type": "string", "minLength": 1 },
    "verifier": { "type": "string", "minLength": 1 },
    "verified_at": { "type": "string", "minLength": 1 }
  }
}
